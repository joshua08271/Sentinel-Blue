{
  "manifest_version": 3,
  "name": "Sentinel Blue Portal Bootstrap",
  "version": "1.9.11",
  "description": "Bootstraps Sentinel Blue only inside a configured authorized competition portal.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinel Blue deployment"
  }
}
