{
  "protected_paths": [
    "/opt/example-service/service.conf"
  ],
  "probes": [
    {
      "name": "local-web",
      "kind": "http",
      "target": "http://127.0.0.1:8080/health",
      "restore_paths": [
        "/etc/nginx/**",
        "/etc/apache2/**",
        "/etc/httpd/**",
        "C:/Windows/System32/inetsrv/**"
      ],
      "expected_status": [200, 401, 403],
      "timeout": 2.0
    },
    {
      "name": "database-port",
      "kind": "tcp",
      "target": "127.0.0.1",
      "host": "127.0.0.1",
      "port": 5432,
      "restore_paths": [
        "/etc/postgresql/**",
        "/var/lib/pgsql/**/postgresql.conf",
        "/var/lib/pgsql/**/pg_hba.conf"
      ],
      "timeout": 2.0
    },
    {
      "name": "dns-answer",
      "kind": "dns",
      "target": "192.0.2.53",
      "port": 53,
      "query": "service.internal",
      "record_type": "A",
      "restore_paths": [
        "/etc/named.conf",
        "/var/named/**"
      ],
      "timeout": 2.0
    },
    {
      "name": "smtp-application",
      "kind": "smtp",
      "target": "192.0.2.25",
      "port": 25,
      "restore_paths": [
        "/etc/postfix/**"
      ],
      "expected": "250",
      "timeout": 2.0
    },
    {
      "name": "generic-application-transaction",
      "kind": "transaction",
      "target": "192.0.2.110",
      "port": 110,
      "initial_expected": "+OK",
      "steps": [
        {"send": "CAPA\r\n", "expect": "+OK"},
        {"send": "QUIT\r\n", "expect": "+OK"}
      ],
      "timeout": 2.0
    }
  ]
}
